#!/bin/bash
# tohq <instance> : camp -> world map -> pick current mission -> headquarters
i=${1:-0}; . "$(dirname "$0")/env.sh"
[ -z "$FROMCAMP" ] && $T/tocamp $i >/dev/null; $T/toworldmap $i >/dev/null
$T/ge $i <<<'return Press(VirtualPad.Cross, 6);' >/dev/null; sleep 3
$T/ge $i <<<'return Press(VirtualPad.Cross, 6);' >/dev/null; sleep 5
$T/ge $i <<<'var c = Labo2Application.getApplication().lgsm_g.scene_.scene_?.TryCast<P2.Bases.Camp.Scene>(); return "camp phase " + c?.controller_.getPhase();'
