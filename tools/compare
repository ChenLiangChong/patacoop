#!/bin/bash
# compare [N] : take the battle state of every copy at (nearly) the same moment and print what differs between
# copy 0 (the host) and the others: each army's position, enemies (missing on one side, position, hit points), gimmicks
N=${N:-${1:-2}}; LAST=$((N-1)); T=$(cd "$(dirname "$0")" && pwd); . "$T/env.sh"
tmp=$(mktemp -d); for i in $(seq 0 $LAST); do ($T/ge $i < $S/snapshot.cs | head -1 > $tmp/$i) & done; wait
python3 - "$tmp" "$N" <<'PY'
import sys, os
d, n = sys.argv[1], int(sys.argv[2])
def parse(line):
    out = {}
    for part in line.split():
        if '=' in part: k, v = part.split('=', 1); out[k] = v
    return out
snaps = [parse(open(os.path.join(d, str(i))).read().strip()) for i in range(n)]
for i, s in enumerate(snaps): print(f"copy {i}: phase {s.get('phase')} me P{int(s.get('me', -1)) + 1} armies {s.get('armies')} enemies {len([e for e in s.get('enemies', '').split(',') if e])}")
def enemies(s):
    r = {}
    for e in s.get('enemies', '').split(','):
        if e.count(':') == 2: i, x, hp = e.split(':'); r[int(i)] = (float(x), int(hp))
    return r
def gimmicks(s):
    r = {}
    for e in s.get('gimmicks', '').split(','):
        if ':' in e: i, hp = e.split(':'); r[int(i)] = int(hp)
    return r
h = snaps[0]
for i in range(1, n):
    o = snaps[i]
    ha, oa = h.get('armies', '').split(','), o.get('armies', '').split(',')
    diffs = []
    for p in range(min(len(ha), len(oa))):
        if '/' in ha[p] and '/' in oa[p]:
            diffs.append(f"P{p + 1} {float(oa[p].split('/')[0]) - float(ha[p].split('/')[0]):+.0f}")
    print(f"copy {i} vs host (phases {h.get('phase')}/{o.get('phase')}): army position differences: {', '.join(diffs) or '-'}")
    he, oe = enemies(h), enemies(o)
    only_h, only_o = sorted(set(he) - set(oe)), sorted(set(oe) - set(he))
    common = set(he) & set(oe)
    dx = max([abs(he[k][0] - oe[k][0]) for k in common] or [0])
    dhp = [k for k in common if he[k][1] != oe[k][1]]
    print(f"  enemies: {len(common)} on both, max position gap {dx:.0f}, hit points differ on {len(dhp)}{' ' + str(dhp[:8]) if dhp else ''}; only host {only_h[:10]}, only copy {i} {only_o[:10]}")
    def units(s):
        r = {}
        for e in s.get('units', '').split(','):
            if ':' in e: i, hp = e.split(':'); r[int(i)] = int(hp)
        return r
    hu, ou = units(h), units(o)
    ud = [k for k in hu if k in ou and hu[k] != ou[k]]
    print(f"  our units: {len(set(hu) & set(ou))} on both, hit points differ on {len(ud)}{' ' + str(ud[:8]) if ud else ''}; only host {sorted(set(hu) - set(ou))[:8]}, only copy {i} {sorted(set(ou) - set(hu))[:8]}")
    hg, og = gimmicks(h), gimmicks(o)
    gd = [f"{k}:{hg[k]}/{og.get(k)}" for k in sorted(hg) if og.get(k) != hg[k]]
    print(f"  gimmicks differing (host/copy): {gd[:10] or 'none'}")
PY
rm -rf "$tmp"
